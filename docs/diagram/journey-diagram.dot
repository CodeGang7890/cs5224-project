// The customer journey, with numbered steps (explained on the right). Fixed positions: render with
// neato -Tpng journey-diagram.dot -o journey-diagram.png
digraph Journey {
  graph [splines=ortho, pad=0.4, fontname="Helvetica", outputorder=edgesfirst, labelloc=t, fontsize=16,
         label=<<b>Customer journey: from a WhatsApp message to payment and reminders</b><br/><font point-size="10">The numbers on the arrows follow the steps on the right.</font>>];
  node [fontname="Helvetica", fontsize=11];
  edge [color="#555555", arrowsize=0.7, penwidth=1.3];
  Customer [label="Customer", pos="0,7!", shape=circle, style=filled, fillcolor="#F9DC5C", color="#C9A227", width=1.0, height=1.0, fixedsize=true];
  WhatsApp [label="WhatsApp API\n(Meta)", pos="2.6,7!", shape=box, style="rounded,filled", fillcolor="#C8EFD4", color="#5A9E6F", width=1.55, height=0.62, fixedsize=true];
  MsgIngester [label="Messaging\nIngester", pos="5.2,7!", shape=box, style="rounded,filled", fillcolor="#CFDDFB", color="#5B7FC7", width=1.55, height=0.62, fixedsize=true];
  MsgQueue [label="Messaging\nQueue", pos="7.8,7!", shape=cylinder, style=filled, fillcolor="#E2DCF8", color="#8C7BD1", width=1.4, height=0.7, fixedsize=true];
  MsgService [label="Messaging\nService", pos="10.4,7!", shape=box, style="rounded,filled", fillcolor="#CFDDFB", color="#5B7FC7", width=1.55, height=0.62, fixedsize=true];
  LLM [label="LLM provider", pos="13.0,7!", shape=box, style="rounded,filled", fillcolor="#C8EFD4", color="#5A9E6F", width=1.55, height=0.62, fixedsize=true];
  Xendit [label="Xendit API\n(payments)", pos="2.6,4.5!", shape=box, style="rounded,filled", fillcolor="#C8EFD4", color="#5A9E6F", width=1.55, height=0.62, fixedsize=true];
  PayIngester [label="Payment\nIngester", pos="5.2,4.5!", shape=box, style="rounded,filled", fillcolor="#CFDDFB", color="#5B7FC7", width=1.55, height=0.62, fixedsize=true];
  PayQueue [label="Payment\nQueue", pos="7.8,4.5!", shape=cylinder, style=filled, fillcolor="#E2DCF8", color="#8C7BD1", width=1.4, height=0.7, fixedsize=true];
  Processing [label="Processing\nService", pos="10.4,4.5!", shape=box, style="rounded,filled", fillcolor="#CFDDFB", color="#5B7FC7", width=1.55, height=0.62, fixedsize=true];
  Storage [label="Object\nStorage", pos="13.0,4.5!", shape=cylinder, style=filled, fillcolor="#7FA6EE", color="#3F68C0", fontcolor="white", width=1.5, height=0.8, fixedsize=true];
  Owner [label="Business\nowner", pos="0,1.8!", shape=circle, style=filled, fillcolor="#F9DC5C", color="#C9A227", width=1.0, height=1.0, fixedsize=true];
  Frontend [label="Frontend web app", pos="2.6,1.8!", shape=box, style="rounded,filled", fillcolor="#F3D9B5", color="#B98B4E", width=1.55, height=0.62, fixedsize=true];
  Auth [label="Auth Provider\n(Google)", pos="2.6,0.2!", shape=box, style="rounded,filled", fillcolor="#C8EFD4", color="#5A9E6F", width=1.55, height=0.62, fixedsize=true];
  Config [label="Configuration\nService", pos="5.2,1.8!", shape=box, style="rounded,filled", fillcolor="#CFDDFB", color="#5B7FC7", width=1.55, height=0.62, fixedsize=true];
  DB [label="Relational\nDatabase", pos="10.4,1.8!", shape=cylinder, style=filled, fillcolor="#7FA6EE", color="#3F68C0", fontcolor="white", width=1.5, height=0.8, fixedsize=true];
  Scheduler [label="Job Scheduler\n(hourly)", pos="15.6,4.5!", shape=box, style="rounded,filled", fillcolor="#F2B27A", color="#C27A3B", width=1.55, height=0.62, fixedsize=true];
  Notification [label="Notification\nJob", pos="15.6,1.8!", shape=box, style="rounded,filled", fillcolor="#CFDDFB", color="#5B7FC7", width=1.55, height=0.62, fixedsize=true];
  Email [label="Email Service", pos="15.6,0.2!", shape=box, style="rounded,filled", fillcolor="#C8EFD4", color="#5A9E6F", width=1.55, height=0.62, fixedsize=true];
  n0 [label="1", pos="1.3,1.8!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  Owner -> n0 [arrowhead=none];
  n0 -> Frontend;
  n1 [label="1", pos="2.6,1.0!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  Frontend -> n1 [arrowhead=none];
  n1 -> Auth;
  n2 [label="2", pos="3.9,1.8!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  Frontend -> n2 [arrowhead=none];
  n2 -> Config;
  n3 [label="2", pos="7.8,1.8!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  Config -> n3 [arrowhead=none];
  n3 -> DB;
  n4 [label="3", pos="1.3,7!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  Customer -> n4 [arrowhead=none];
  n4 -> WhatsApp;
  n5 [label="4", pos="3.9,7!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  WhatsApp -> n5 [arrowhead=none];
  n5 -> MsgIngester;
  n6 [label="4", pos="4.7,3.15!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  MsgIngester -> n6 [arrowhead=none];
  n6 -> Config;
  n7 [label="5", pos="6.5,7!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  MsgIngester -> n7 [arrowhead=none];
  n7 -> MsgQueue;
  n8 [label="6", pos="9.1,7!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  MsgQueue -> n8 [arrowhead=none];
  n8 -> MsgService;
  n9 [label="7", pos="11.7,7!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  MsgService -> n9 [dir=back, arrowtail=normal];
  n9 -> LLM;
  n10 [label="7", pos="11.4,3.15!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  MsgService -> n10 [dir=back, arrowtail=normal];
  n10 -> DB;
  n11 [label="8", pos="9.1,5.75!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  MsgService -> n11 [arrowhead=none];
  n11 -> Xendit;
  n12 [label="9", pos="6.5,8.3!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  MsgService -> n12 [arrowhead=none];
  n12 -> WhatsApp;
  n13 [label="10", pos="1.3,4.5!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  Customer -> n13 [arrowhead=none];
  n13 -> Xendit;
  n14 [label="11", pos="3.9,4.5!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  Xendit -> n14 [arrowhead=none];
  n14 -> PayIngester;
  n15 [label="12", pos="6.5,4.5!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  PayIngester -> n15 [arrowhead=none];
  n15 -> PayQueue;
  n16 [label="13", pos="9.1,4.5!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  PayQueue -> n16 [arrowhead=none];
  n16 -> Processing;
  n17 [label="13", pos="10.4,3.15!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  Processing -> n17 [arrowhead=none];
  n17 -> DB;
  n18 [label="14", pos="11.7,4.5!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  Processing -> n18 [arrowhead=none];
  n18 -> Storage;
  n19 [label="15", pos="6.5,8.75!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  Processing -> n19 [arrowhead=none];
  n19 -> WhatsApp;
  n20 [label="16", pos="15.6,3.15!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  Scheduler -> n20 [arrowhead=none];
  n20 -> Notification;
  n21 [label="17", pos="13.0,1.8!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  Notification -> n21 [arrowhead=none];
  n21 -> DB;
  n22 [label="18", pos="6.5,9.2!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  Notification -> n22 [arrowhead=none];
  n22 -> WhatsApp;
  n23 [label="18", pos="15.6,1.0!", shape=circle, style=filled, fillcolor="#C62828", color="#C62828", fontcolor="white", fontname="Helvetica-Bold", fontsize=10, width=0.32, height=0.32, fixedsize=true];
  Notification -> n23 [arrowhead=none];
  n23 -> Email;
  Steps [pos="20.1,4.4!", shape=plain, fontsize=10, label=<
    <table border="0" cellborder="0" cellspacing="0" cellpadding="3">
      <tr><td colspan="2" align="left"><b>Steps</b></td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>1</b></font></td><td align="left" balign="left">The business owner signs in to the web app with their Google account.</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>2</b></font></td><td align="left" balign="left">They set up the catalog (products, services, schedules, FAQs), the chat settings<br/>and the WhatsApp connection; the Configuration Service saves them.</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>3</b></font></td><td align="left" balign="left">A customer sends a WhatsApp message to the business.</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>4</b></font></td><td align="left" balign="left">Meta calls the Messaging Ingester's webhook; it checks the signature with the<br/>Configuration Service (which holds the secrets).</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>5</b></font></td><td align="left" balign="left">The ingester publishes the message to the Messaging Queue (in order, per<br/>customer).</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>6</b></font></td><td align="left" balign="left">The Messaging Service pulls it and runs the chat flow.</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>7</b></font></td><td align="left" balign="left">The LLM routes the message, extracts the order / booking details and writes the<br/>reply, calling its tools to look up the catalog and FAQs. The flow saves the<br/>chat, the order / booking (pending payment, with a payment reference; stock and<br/>time slot on hold) and questions the FAQs can't answer.</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>8</b></font></td><td align="left" balign="left">It creates a Xendit invoice (payment link) for the payment reference.</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>9</b></font></td><td align="left" balign="left">It replies on WhatsApp: the confirmation and the payment link.</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>10</b></font></td><td align="left" balign="left">The customer pays on Xendit.</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>11</b></font></td><td align="left" balign="left">Xendit calls the Payment Ingester's webhook (success or failure).</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>12</b></font></td><td align="left" balign="left">The ingester publishes {payment_reference, status} to the Payment Queue.</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>13</b></font></td><td align="left" balign="left">The Processing Service updates the order / booking: payment received (the time<br/>slot is booked) or failed (stock and time freed). A duplicate event changes<br/>nothing.</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>14</b></font></td><td align="left" balign="left">It generates the invoice (PDF) and uploads it to Object Storage.</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>15</b></font></td><td align="left" balign="left">It tells the customer on WhatsApp, with the invoice link.</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>16</b></font></td><td align="left" balign="left">Every hour, the Job Scheduler runs the Notification Job.</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>17</b></font></td><td align="left" balign="left">It finds orders / bookings still unpaid 1 to 2 hours after they were made, and<br/>bookings starting in 23 to 24 hours.</td></tr>
      <tr><td align="right" valign="top"><font color="#C62828"><b>18</b></font></td><td align="left" balign="left">It sends the payment and appointment reminders by WhatsApp and email.</td></tr>
    </table>>];
}
