// Object diagram of the models defined in configuration-service's models.py files (the tables the
// code creates; Django's own tables, e.g. auth groups / permissions, sessions, admin log and the
// JWT token blacklist, are left out). Render with: dot -Tpng object-diagram.dot -o object-diagram.png
digraph ObjectDiagram {
  graph [rankdir=TB, splines=ortho, fontname="Helvetica", pad=0.5, nodesep=0.5, ranksep=1.4, newrank=true, forcelabels=true,
         label=<<b>Ansera Business Admin: object diagram</b> (configuration-service models)<br/><font point-size="10">PK = primary key, FK = foreign key. All IDs are BigAutoField.</font>>,
         labelloc=t, fontsize=16];
  node  [shape=plain, fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=9, color="#555555", arrowhead=none, labeldistance=1.8];

  // --- configuration_app (green) ----------------------------------------------------------
  BusinessConfiguration [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#2E7D32">
      <tr><td bgcolor="#2E7D32"><font color="white"><b>BusinessConfiguration</b></font><br/><font color="white" point-size="8">configuration_app · the business (tenant)</font></td></tr>
      <tr><td align="left" balign="left">
        <u>id</u> (PK)<br/>
        business_name: CharField(150), not empty<br/>
        description: TextField(2000), optional<br/>
        location: CharField(255), not empty
      </td></tr>
    </table>>];

  WhatsAppConfiguration [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#2E7D32">
      <tr><td bgcolor="#2E7D32"><font color="white"><b>WhatsAppConfiguration</b></font><br/><font color="white" point-size="8">configuration_app · WhatsApp Cloud API connection</font></td></tr>
      <tr><td align="left" balign="left">
        <u>id</u> (PK)<br/>
        <b>business</b>: OneToOne → BusinessConfiguration<br/>
        phone_number_id: CharField(32), digits, unique<br/>
        access_token: encrypted text<br/>
        app_secret: encrypted text<br/>
        display_phone_number: CharField(32), from Meta<br/>
        verified_name: CharField(255), from Meta<br/>
        verify_token: CharField(64), random<br/>
        created_time, last_updated: DateTime
      </td></tr>
    </table>>];

  // --- auth_app (blue) --------------------------------------------------------------------
  BusinessUser [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#1565C0">
      <tr><td bgcolor="#1565C0"><font color="white"><b>BusinessUser</b></font><br/><font color="white" point-size="8">auth_app · extends Django AbstractUser</font></td></tr>
      <tr><td align="left" balign="left">
        <u>id</u> (PK)<br/>
        username: CharField(150), unique<br/>
        password: CharField(128), hashed<br/>
        email, first_name, last_name<br/>
        is_active, is_staff, is_superuser<br/>
        last_login, date_joined: DateTime<br/>
        groups, user_permissions: M2M (Django tables)<br/>
        <b>business</b>: FK → BusinessConfiguration, nullable
      </td></tr>
    </table>>];

  // --- product_app (orange) ---------------------------------------------------------------
  Product [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#EF6C00">
      <tr><td bgcolor="#EF6C00"><font color="white"><b>Product</b></font><br/><font color="white" point-size="8">product_app</font></td></tr>
      <tr><td align="left" balign="left">
        <u>id</u> (PK)<br/>
        <b>business</b>: FK → BusinessConfiguration<br/>
        name: CharField(150), unique per business<br/>
        description: TextField(300), optional<br/>
        information: TextField(5000), optional<br/>
        price: Decimal(10, 2), ≥ 0<br/>
        total_quantity: PositiveInteger (≤ 1,000,000)<br/>
        is_active: Boolean<br/>
        <i>derived from orders: quantity_on_hold,</i><br/>
        <i>quantity_sold, quantity_available</i>
      </td></tr>
    </table>>];

  FAQ [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#EF6C00">
      <tr><td bgcolor="#EF6C00"><font color="white"><b>FAQ</b></font><br/><font color="white" point-size="8">product_app</font></td></tr>
      <tr><td align="left" balign="left">
        <u>id</u> (PK)<br/>
        <b>business</b>: FK → BusinessConfiguration<br/>
        question: CharField(300), unique per business<br/>
        answer: TextField(10000)
      </td></tr>
    </table>>];

  ServiceProvider [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#EF6C00">
      <tr><td bgcolor="#EF6C00"><font color="white"><b>ServiceProvider</b></font><br/><font color="white" point-size="8">product_app · e.g. a photographer or a court</font></td></tr>
      <tr><td align="left" balign="left">
        <u>id</u> (PK)<br/>
        <b>business</b>: FK → BusinessConfiguration<br/>
        name: CharField(150), unique per business<br/>
        description: CharField(300), optional<br/>
        is_active: Boolean
      </td></tr>
    </table>>];

  WeeklyAvailability [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#EF6C00">
      <tr><td bgcolor="#EF6C00"><font color="white"><b>WeeklyAvailability</b></font><br/><font color="white" point-size="8">product_app · one provider's week</font></td></tr>
      <tr><td align="left" balign="left">
        <u>id</u> (PK)<br/>
        <b>service_provider</b>: FK → ServiceProvider<br/>
        week: Date (a Monday), unique per provider<br/>
        availability: CharField(672), one letter per<br/>
        15-minute block: O open · U unavailable ·<br/>
        H on hold · X booked
      </td></tr>
    </table>>];

  Service [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#EF6C00">
      <tr><td bgcolor="#EF6C00"><font color="white"><b>Service</b></font><br/><font color="white" point-size="8">product_app · bookable time slots</font></td></tr>
      <tr><td align="left" balign="left">
        <u>id</u> (PK)<br/>
        <b>business</b>: FK → BusinessConfiguration<br/>
        <b>service_providers</b>: M2M → ServiceProvider<br/>
        name: CharField(150), unique per business<br/>
        description: TextField(300), optional<br/>
        information: TextField(5000), optional<br/>
        price: Decimal(10, 2), ≥ 0<br/>
        duration_minutes: 15–1440 (×15)<br/>
        buffer_minutes: 0–1440 (×15)<br/>
        start_interval_minutes: 15–1440 (×15)<br/>
        is_active: Boolean
      </td></tr>
    </table>>];


  // --- chat_app (purple) ------------------------------------------------------------------
  ChatConfiguration [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#6A1B9A">
      <tr><td bgcolor="#6A1B9A"><font color="white"><b>ChatConfiguration</b></font><br/><font color="white" point-size="8">chat_app · settings of the fixed chat flow</font></td></tr>
      <tr><td align="left" balign="left">
        <u>id</u> (PK)<br/>
        <b>business</b>: OneToOne → BusinessConfiguration<br/>
        product_detail_fields: JSON (details for orders)<br/>
        schedule_detail_fields: JSON (details for bookings)<br/>
        welcome_message: CharField(1000), optional<br/>
        reply_style: friendly | professional | casual |<br/>
        brief | custom<br/>
        custom_style: CharField(500), required if custom<br/>
        last_updated: DateTime (auto)
      </td></tr>
    </table>>];

  ChatSession [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#6A1B9A">
      <tr><td bgcolor="#6A1B9A"><font color="white"><b>ChatSession</b></font><br/><font color="white" point-size="8">chat_app · one customer's conversation</font></td></tr>
      <tr><td align="left" balign="left">
        <u>id</u> (PK)<br/>
        <b>business</b>: FK → BusinessConfiguration<br/>
        phone_number: CharField(16), E.164, unique per<br/>
        business (real chats; optional for sandbox)<br/>
        display_name: CharField(150), optional<br/>
        is_sandbox: Boolean<br/>
        created_time, last_chat_time: DateTime<br/>
        chat_message_json: JSON (the messages)<br/>
        chat_state_id: CharField(32), the flow step<br/>
        chat_state_data: JSON (what the flow collected)
      </td></tr>
    </table>>];

  UnansweredQuestion [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#6A1B9A">
      <tr><td bgcolor="#6A1B9A"><font color="white"><b>UnansweredQuestion</b></font><br/><font color="white" point-size="8">chat_app · for the business to answer</font></td></tr>
      <tr><td align="left" balign="left">
        <u>id</u> (PK)<br/>
        <b>business</b>: FK → BusinessConfiguration<br/>
        <b>chat_session</b>: FK → ChatSession<br/>
        <b>faq</b>: FK → FAQ, nullable (once answered)<br/>
        question: CharField(300), not empty<br/>
        status: open | answered | dismissed<br/>
        created_time: DateTime<br/>
        answered_time: DateTime, set iff answered
      </td></tr>
    </table>>];

  // --- checkout_app (teal) ----------------------------------------------------------------
  OrderItem [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#00796B">
      <tr><td bgcolor="#00796B"><font color="white"><b>OrderItem</b></font><br/><font color="white" point-size="8">checkout_app · one product order</font></td></tr>
      <tr><td align="left" balign="left">
        <u>id</u> (PK)<br/>
        <b>business</b>: FK → BusinessConfiguration<br/>
        <b>chat_session</b>: FK → ChatSession, nullable<br/>
        is_sandbox: Boolean<br/>
        order_data: JSON (items: product_id, name,<br/>
        unit_price, quantity; customer details)<br/>
        order_status: pending_payment |<br/>
        payment_received | order_completed |<br/>
        payment_failed<br/>
        payment_reference: CharField(32), random<br/>
        128-bit hex<br/>
        created_time, updated_time: DateTime
      </td></tr>
    </table>>];

  ScheduleItem [label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#00796B">
      <tr><td bgcolor="#00796B"><font color="white"><b>ScheduleItem</b></font><br/><font color="white" point-size="8">checkout_app · one booking</font></td></tr>
      <tr><td align="left" balign="left">
        <u>id</u> (PK)<br/>
        <b>business</b>: FK → BusinessConfiguration<br/>
        <b>chat_session</b>: FK → ChatSession, nullable<br/>
        <b>service</b>: FK → Service, nullable<br/>
        <b>service_provider</b>: FK → ServiceProvider, nullable<br/>
        is_sandbox: Boolean<br/>
        start_time, end_time (start + duration),<br/>
        blocked_until (end + buffer): DateTime<br/>
        schedule_data: JSON (service snapshot,<br/>
        customer details)<br/>
        order_status: as OrderItem<br/>
        payment_reference: CharField(32), random<br/>
        128-bit hex<br/>
        created_time, updated_time: DateTime
      </td></tr>
    </table>>];

  // --- Relations: bar = 1, crow's foot = many (the "many" side holds the foreign key) --------
  edge [fontsize=10, fontcolor="#333333", penwidth=1.4, arrowsize=0.9, labeldistance=1.6, labelangle=30];
  BusinessConfiguration -> WhatsAppConfiguration [dir=both, arrowtail=tee, arrowhead=tee, taillabel="1", headlabel="1", color="#2E7D32"];
  BusinessConfiguration -> BusinessUser [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#1565C0"];
  BusinessConfiguration -> ChatConfiguration [dir=both, arrowtail=tee, arrowhead=tee, taillabel="1", headlabel="1", color="#6A1B9A"];
  BusinessConfiguration -> Product [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#EF6C00"];
  BusinessConfiguration -> FAQ [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#EF6C00"];
  BusinessConfiguration -> ChatSession [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#6A1B9A"];
  BusinessConfiguration -> Service [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#EF6C00"];
  BusinessConfiguration -> ServiceProvider [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#EF6C00"];
  BusinessConfiguration -> UnansweredQuestion [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#6A1B9A"];
  BusinessConfiguration -> OrderItem [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#00796B"];
  BusinessConfiguration -> ScheduleItem [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#00796B"];
  FAQ -> UnansweredQuestion [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#6A1B9A"];
  ChatSession -> UnansweredQuestion [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#6A1B9A"];
  ChatSession -> OrderItem [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#00796B"];
  ChatSession -> ScheduleItem [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#00796B"];
  Service -> ScheduleItem [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#00796B"];
  ServiceProvider -> ScheduleItem [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#00796B"];
  Service -> ServiceProvider [dir=both, arrowtail=crow, arrowhead=crow, taillabel="many", headlabel="many", color="#EF6C00"];
  ServiceProvider -> WeeklyAvailability [dir=both, arrowtail=tee, arrowhead=crow, taillabel="1", headlabel="many", color="#EF6C00"];

  // --- Layout: the business on top, the tables it owns below, the tables depending on those last.
  { rank=same; WhatsAppConfiguration; BusinessUser; ChatConfiguration; Product; FAQ; ChatSession; Service; ServiceProvider; }
  { rank=same; UnansweredQuestion; OrderItem; ScheduleItem; WeeklyAvailability; }
  // Left-to-right order within the rows (invisible edges).
  edge [style=invis, dir=none];
  WhatsAppConfiguration -> BusinessUser -> ChatConfiguration -> Product -> FAQ -> ChatSession -> Service -> ServiceProvider;
  UnansweredQuestion -> OrderItem -> ScheduleItem -> WeeklyAvailability;

  // --- Legend -----------------------------------------------------------------------------
  Legend [label=<
    <table border="0" cellborder="0" cellspacing="2" cellpadding="3">
      <tr><td align="left" colspan="2"><b>Legend</b></td></tr>
      <tr><td align="left"><b>1 — 1</b></td><td align="left">one-to-one (a bar at both ends)</td></tr>
      <tr><td align="left"><b>1 — many</b></td><td align="left">one-to-many (bar = 1, crow's foot = many; the "many" side has the foreign key)</td></tr>
      <tr><td align="left"><b>many — many</b></td><td align="left">many-to-many (crow's foot at both ends; stored in Django's link table)</td></tr>
      <tr><td align="left" colspan="2" balign="left">Deleting a business deletes its rows, except its users (their link is cleared).<br/>Table names: &lt;app&gt;_&lt;model&gt;.</td></tr>
    </table>>];
  { rank=same; BusinessConfiguration; Legend; }
  BusinessConfiguration -> Legend [style=invis];
}
