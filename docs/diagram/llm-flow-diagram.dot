// The chat flow for one customer message: messaging-service/app/chat_flow (a port of
// configuration-service/chat_app). Render with: dot -Tpng llm-flow-diagram.dot -o llm-flow-diagram.png
digraph LLMFlow {
  graph [rankdir=LR, splines=ortho, nodesep=0.25, ranksep=0.5, pad=0.4, fontname="Helvetica", newrank=true,
         label=<<b>Chat flow: one customer message</b><br/><font point-size="10">messaging-service app/chat_flow (= configuration-service chat_app) · LLM = Ollama qwen2.5:7b · structured calls return JSON for a schema (temperature 0); code decides and saves</font>>,
         labelloc=t, fontsize=15];
  node  [fontname="Helvetica", fontsize=9, margin="0.1,0.05", shape=box, style="rounded,filled", fillcolor="#E3F2FD", color="#1565C0"];
  edge  [fontname="Helvetica", fontsize=8, color="#555555", arrowsize=0.6];

  // LLM boxes: name, output, then the tools it is given.
  // DB writes: green cylinders. Templates: grey notes.

  In [label=<<b>Customer message</b>>, fillcolor="#FFFFFF", color="#333333", style="rounded,filled,bold"];
  SaveIn [label=<<b>Save message</b><br/>+ welcome (template)<br/>on a chat's first message>, shape=cylinder, fillcolor="#E8F5E9", color="#2E7D32", style=filled];
  Router [label=<<b>Router LLM</b><br/>{intents}<br/><font color="#5E35B1">tools: none</font>>, fillcolor="#EDE7F6", color="#5E35B1", style="rounded,filled,bold"];
  In -> SaveIn -> Router;

  // --- Order lane --------------------------------------------------------------------------
  subgraph cluster_order {
    label=<<b>Order</b> · intent order, or an order in progress>; labeljust=l; fontsize=10; fontcolor="#EF6C00"; color="#EF6C00"; style="rounded,dashed"; margin=8;
    O1 [label=<<b>Product selection LLM</b><br/>{items, done_choosing}<br/><font color="#5E35B1">tools: none</font>>, fillcolor="#EDE7F6", color="#5E35B1"];
    O1c [label=<<b>check</b><br/>on sale · ≤ in stock<br/>· cart confirmed>];
    O2 [label=<<b>Details LLM</b><br/>{a key per detail field}<br/><font color="#5E35B1">tools: none</font>>, fillcolor="#EDE7F6", color="#5E35B1"];
    O2c [label=<<b>check</b><br/>types · all<br/>required valid>];
    O3 [label=<<b>Confirmation LLM</b><br/>{decision}<br/><font color="#5E35B1">tools: none</font>>, fillcolor="#EDE7F6", color="#5E35B1"];
    O4 [label=<<b>place_order</b><br/>lock products · re-check stock<br/>OrderItem pending_payment<br/>→ stock on hold>, shape=cylinder, fillcolor="#E8F5E9", color="#2E7D32", style=filled];
    O1 -> O1c -> O2 -> O2c -> O3;
    O3 -> O4 [xlabel="confirm"];
  }

  // --- Booking lane ------------------------------------------------------------------------
  subgraph cluster_booking {
    label=<<b>Booking</b> · intent booking, or a booking in progress>; labeljust=l; fontsize=10; fontcolor="#00796B"; color="#00796B"; style="rounded,dashed"; margin=8;
    B1 [label=<<b>Service selection LLM</b><br/>{service_id}<br/><font color="#5E35B1">tools: none</font>>, fillcolor="#EDE7F6", color="#5E35B1"];
    B2 [label=<<b>Time slot LLM</b><br/>{choice, date, time, part}<br/><font color="#5E35B1">tools: none</font>>, fillcolor="#EDE7F6", color="#5E35B1"];
    B2c [label=<<b>check</b> (code)<br/>free times from the weekly<br/>letters · offer up to 6>];
    B3 [label=<<b>Booking details LLM</b><br/>{a key per detail field}<br/><font color="#5E35B1">tools: none</font>>, fillcolor="#EDE7F6", color="#5E35B1"];
    B4 [label=<<b>Booking confirmation LLM</b><br/>{decision}<br/><font color="#5E35B1">tools: none</font>>, fillcolor="#EDE7F6", color="#5E35B1"];
    B5 [label=<<b>place_booking</b><br/>lock providers · re-check time<br/>ScheduleItem pending_payment<br/>→ blocks on hold (H)>, shape=cylinder, fillcolor="#E8F5E9", color="#2E7D32", style=filled];
    B1 -> B2 -> B2c -> B3 -> B4;
    B4 -> B5 [xlabel="confirm"];
  }

  // --- FAQ lane ----------------------------------------------------------------------------
  subgraph cluster_faq {
    label=<<b>FAQ</b> · intent question>; labeljust=l; fontsize=10; fontcolor="#6A1B9A"; color="#6A1B9A"; style="rounded,dashed"; margin=8;
    Q1 [label=<<b>Load</b> FAQs, catalog and the<br/>information of the products /<br/>services the message names>];
    Q2 [label=<<b>Question check LLM</b><br/>{kind: none · answered ·<br/>unanswered, question}<br/><font color="#5E35B1">tools: none</font>>, fillcolor="#EDE7F6", color="#5E35B1"];
    Q3 [label=<<b>ask_business</b> (code)<br/>if unanswered: save an<br/>open UnansweredQuestion>, shape=cylinder, fillcolor="#E8F5E9", color="#2E7D32", style=filled];
    Q1 -> Q2;
    Q2 -> Q3;
  }

  // --- Order status lane -------------------------------------------------------------------
  subgraph cluster_status {
    label=<<b>Order status</b> · intent order_status (past orders / bookings)>; labeljust=l; fontsize=10; fontcolor="#AD1457"; color="#AD1457"; style="rounded,dashed"; margin=8;
    S1 [label=<<b>Order status LLM</b><br/>{kind, numbers}<br/><font color="#5E35B1">tools: none</font>>, fillcolor="#EDE7F6", color="#5E35B1"];
    S2 [label=<<b>lookup</b> (code)<br/>only the customer's own<br/>(same phone); else "not found">];
    S3 [label=<<b>Order status reply LLM</b><br/>from those records only<br/><font color="#5E35B1">tools: none</font>>, fillcolor="#EDE7F6", color="#5E35B1"];
    S4 [label=<<b>grounding check</b><br/>names other numbers, or<br/>nothing found → message<br/>written by code>];
    S1 -> S2 -> S3 -> S4;
  }

  // --- Reply -----------------------------------------------------------------------------
  Commit [label=<<b>commit_turn</b><br/>save the step + data<br/>(with the order / booking)>, shape=cylinder, fillcolor="#E8F5E9", color="#2E7D32", style=filled];
  Templates [label=<<b>Template</b> (never the LLM)<br/>at a confirmation / time slot:<br/>summary + "reply CONFIRM",<br/>"#N is confirmed", free times>, shape=note, fillcolor="#F5F5F5", color="#757575", style=filled];
  Aside [label=<<b>Aside LLM</b><br/>+ question / order status /<br/>off topic, next to the template<br/><font color="#5E35B1">tools: all 5 ▸</font>>, fillcolor="#EDE7F6", color="#5E35B1"];
  Reply [label=<<b>Reply LLM</b> (otherwise)<br/>step, missing, issues, catalog,<br/>FAQ result, order records, style<br/><font color="#5E35B1">tools: all 5 ▸</font>>, fillcolor="#EDE7F6", color="#5E35B1", style="rounded,filled,bold"];
  SaveOut [label=<<b>Save reply</b>>, shape=cylinder, fillcolor="#E8F5E9", color="#2E7D32", style=filled];
  Out [label=<<b>Response</b>>, fillcolor="#FFFFFF", color="#333333", style="rounded,filled,bold"];
  Templates -> Aside [style=dashed];
  Templates -> SaveOut; Aside -> SaveOut; Reply -> SaveOut; SaveOut -> Out;

  Tools [label=<<table border="0" cellborder="0" cellspacing="0" cellpadding="1">
      <tr><td align="left"><b>The 5 tools</b> (read-only, this business, ≤ 3 rounds)</td></tr>
      <tr><td align="left">list_products · get_product_details</td></tr>
      <tr><td align="left">list_services · get_service_details · list_faqs</td></tr></table>>,
      fillcolor="#FFFDE7", color="#F9A825", style="rounded,filled,dashed"];

  // --- Routing -----------------------------------------------------------------------------
  Router -> O1; Router -> B1; Router -> Q1; Router -> S1;
  Router -> Commit [xlabel="no order / booking step"];

  O3 -> Commit [xlabel="not yet"]; O4 -> Commit;
  B4 -> Commit [xlabel="not yet"]; B5 -> Commit;
  Commit -> Templates;
  Commit -> Reply;
  Q2 -> Reply [xlabel="answered"]; Q3 -> Reply;
  S4 -> SaveOut [xlabel="only order status"];
  S2 -> Reply [style=dashed, xlabel="+ other intents"];
  Reply -> Tools [dir=both, style=dashed, color="#F9A825", arrowsize=0.5];

  // --- Columns (left to right) -------------------------------------------------------------
  { rank=same; O1; B1; Q1; S1; }
  { rank=same; O1c; B2; Q2; S2; }
  { rank=same; O2; B2c; Q3; S3; }
  { rank=same; O2c; B3; S4; }
  { rank=same; O3; B4; }
  { rank=same; O4; B5; }
  { rank=same; Templates; Reply; }

  // --- Legend ------------------------------------------------------------------------------
  Legend [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="2" cellpadding="3">
      <tr><td bgcolor="#EDE7F6" color="#5E35B1"><font point-size="8">LLM call</font></td>
          <td bgcolor="#E3F2FD" color="#1565C0"><font point-size="8">code</font></td>
          <td bgcolor="#E8F5E9" color="#2E7D32"><font point-size="8">database write</font></td>
          <td bgcolor="#F5F5F5" color="#757575"><font point-size="8">fixed template</font></td></tr>
    </table>>];
  { rank=same; In; Legend; }
  In -> Legend [style=invis];
  { rank=same; Reply; Tools; }
}
