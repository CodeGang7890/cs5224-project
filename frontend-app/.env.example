# Copy to .env.local and adjust.

# API root of configuration-service (Django), used by `configurationApiClient`.
# Endpoints are relative to it, e.g. /auth/token/, /configuration/random-number/, /products/.
VITE_CONFIGURATION_SERVICE_URL=http://localhost:8000/api

# WhatsApp Embedded Signup ("Connect with Facebook"): our Meta app's ID and its Facebook Login for
# Business configuration ID (App Dashboard → Facebook Login for Business → Configurations). Empty: the
# button shows but does nothing. Meta only allows the popup on HTTPS domains set on the app (not localhost).
# configuration-service needs META_APP_ID / META_APP_SECRET too.
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
VITE_META_GRAPH_API_VERSION=v26.0

# Logging in with Google / Facebook (Google Cloud Identity Platform): the Firebase web app's apiKey,
# authDomain (e.g. <project>.firebaseapp.com) and projectId (Firebase console → Project settings → Your
# apps, or `terraform output`). Empty: the buttons show but do nothing. configuration-service needs
# FIREBASE_PROJECT_ID too. The page's domain must be an authorized domain (localhost is by default).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
