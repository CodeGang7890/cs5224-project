# Copy to .env.local and adjust.

# API root of configuration-service (Django), used by `configurationApiClient`.
# Endpoints are relative to it, e.g. /auth/token/, /configuration/random-number/, /products/.
VITE_CONFIGURATION_SERVICE_URL=http://localhost:8000/api

# API root of messaging-service (FastAPI), used by `messagingApiClient`: the chat flow, e.g.
# /chat/sandbox-sessions/{id}/messages/ (the Chat Sandbox). It accepts the same login tokens.
VITE_MESSAGING_SERVICE_URL=http://localhost:8004/api
