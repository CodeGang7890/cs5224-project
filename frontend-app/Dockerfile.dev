# Development image: the Vite dev server with hot reload. docker-compose.yml mounts the source
# into /app, so edits on the host show up in the browser without a rebuild.
# Vite 8 needs Node 20.19+ or 22.12+.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 5173

# --host 0.0.0.0 so the dev server is reachable from outside the container.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
