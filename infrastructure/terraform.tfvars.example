project_id = "YOUR_GCP_PROJECT_ID"
region     = "us-central1"
retire_us_resources = true # Keep the retired US regional stack absent. This project's active stack is in Singapore.
enable_singapore_staging = false
singapore_region          = "asia-southeast1"
singapore_vpc_network       = "default"
singapore_vpc_subnetwork    = "default"
singapore_vpc_subnet_cidr   = "10.148.0.0/20"
manage_singapore_load_balancer = true # Adopt the existing LB/Armor resources when Singapore is enabled.
mock_whatsapp_public_path_prefix = "/whatsapp"
singapore_github_app_installation_id = 0 # Set to the existing Cloud Build GitHub App installation ID during migration.
singapore_github_token_version       = "1"
singapore_stage_backend_services      = ["messaging-ingester", "payment-ingester", "messaging-service", "processing-service"]
singapore_build_triggers_enabled       = false
singapore_notification_scheduler_enabled = false
singapore_sql_promoted                   = false
recovery_sql_connection_name             = "" # During a verified PITR cutover only: project:asia-southeast1:clone-name.
singapore_queue_consumers_enabled        = false
singapore_min_instances                  = 0
singapore_public_endpoints_enabled       = false
singapore_service_urls                   = {} # Fill with Cloud Run URLs after creating Singapore services.
frontend_configuration_service_url       = "https://ansera.hopto.org/api" # HTTPS load balancer hostname for Firebase browser requests.
backend_configuration_service_url        = "https://34-149-82-198.sslip.io/api" # Temporary backend path; use direct run.app URL only after VPC routing works.
django_allowed_hosts                     = ".run.app,34-149-82-198.sslip.io,ansera.hopto.org" # Keep the temporary host until the new certificate is ready.
us_queue_consumers_enabled              = true
us_build_triggers_enabled                = true
us_public_endpoints_enabled              = true
us_legacy_messaging_ingester_public      = false # Temporary Meta bridge only; disable after all Meta callbacks use Singapore.
us_legacy_payment_ingester_public        = false # Temporary Xendit bridge only; disable after Xendit callbacks use Singapore.
us_legacy_messaging_ingester_configuration_service_url = "https://configuration-service-gq6jjn4afq-uc.a.run.app/api"
us_min_instances                         = 1
pubsub_allowed_persistence_regions       = [] # Set to ["asia-southeast1"] after cutover.

# Only set image URLs for services that are ready to deploy.
service_images = {}
messaging_service_url = "https://messaging-service-gq6jjn4afq-as.a.run.app"

# Cloud SQL incurs ongoing charges. DNS requires a domain you own.
enable_cloud_sql = false
dns_domain       = ""

# Firebase enrollment is permanent for the project. Enable when ready.
enable_firebase         = false
firebase_hosting_site_id = "cs5224-ansera"
# Add a custom frontend origin here if you use one; the Firebase Hosting domains are included automatically.
additional_browser_origins = []

# Existing Cloud Build 2nd gen GitHub connection and repository.
github_connection_name = "ansera"
github_repository_name = "cs5224-project"
github_repository_uri  = "https://github.com/CodeGang7890/cs5224-project.git"
github_branch_regex    = "^main$"

# Keep CI/CD disabled until the app services are production-ready.
enable_ci_cd   = false
ci_cd_services = [
  "configuration-service",
  "messaging-service",
  "messaging-ingester",
  "processing-service",
  "payment-ingester",
]

notification_schedule = "0 * * * *"
enable_notification_scheduler = false
notification_job_image       = "us-docker.pkg.dev/cloudrun/container/hello"
enable_vertex_ai       = true
vertex_ai_services      = ["messaging-service"]
vertex_ai_location     = "global"
vertex_ai_model        = "gemini-3.5-flash-lite"

# mock_whatsapp on Cloud Run (mock-whatsapp.tf): a WhatsApp stand-in for demos, one instance in Singapore.
# whatsapp_replies_to = "mock" sends every WhatsApp reply to it instead of Meta ("meta": real WhatsApp),
# and makes it public (anyone with the URL can chat as a sample customer: LLM charges).
enable_mock_whatsapp                = true
whatsapp_replies_to                 = "mock"
mock_whatsapp_allow_unauthenticated = false

# Email for the trial Cloud Run HTTP 4xx/5xx alert; blank creates incidents only.
alert_notification_email = ""

# WhatsApp Embedded Signup ("Connect with Facebook"), always on. Before the first apply, add the
# App Secret: gcloud secrets versions add meta-app-secret --data-file=… .
# Terraform stores the webhook verify token from private terraform.tfvars in Secret Manager.
meta_app_id                    = "2228337358565044"
meta_embedded_signup_config_id = "1330129685818612"
meta_app_secret_version        = "3"
# Keep the exact Meta webhook verify token in the ignored terraform.tfvars only.
meta_webhook_verify_token      = ""
messaging_ingester_public_url  = ""

# Logging in with Google / Facebook comes with enable_firebase (identity.tf; enabling Identity Platform
# can't be undone). The providers are set up in the console (README).
