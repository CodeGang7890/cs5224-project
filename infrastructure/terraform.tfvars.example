project_id = "YOUR_GCP_PROJECT_ID"
region     = "us-central1"

# Only set image URLs for services that are ready to deploy.
service_images = {}
messaging_service_url = "https://messaging-service-gq6jjn4afq-uc.a.run.app"

# Cloud SQL incurs ongoing charges. DNS requires a domain you own.
enable_cloud_sql = false
dns_domain       = ""

# Firebase enrollment is permanent for the project. Enable when ready.
enable_firebase         = false
firebase_hosting_site_id = "cs5224-ansera"
# Add a custom frontend origin here if you use one; the Firebase Hosting domains are included automatically.
additional_browser_origins = []

# Existing Cloud Build 2nd gen GitHub connection and repository.
github_connection_name = "ansera"
github_repository_name = "cs5224-project"
github_repository_uri  = "https://github.com/CodeGang7890/cs5224-project.git"
github_branch_regex    = "^main$"

# Keep CI/CD disabled until the app services are production-ready.
enable_ci_cd   = false
ci_cd_services = [
  "configuration-service",
  "messaging-service",
  "messaging-ingester",
  "processing-service",
  "payment-ingester",
]

notification_schedule = "0 * * * *"
enable_notification_scheduler = false
notification_job_image       = "us-docker.pkg.dev/cloudrun/container/hello"
enable_vertex_ai       = true
vertex_ai_services      = ["messaging-service"]
vertex_ai_location     = "global"
vertex_ai_model        = "gemini-3.5-flash-lite"

# Standalone browser demo. Public access can allow untrusted model requests and charges.
enable_vertex_ai_demo                 = false
vertex_ai_demo_allow_unauthenticated = false

# Email for the trial Cloud Run HTTP 4xx/5xx alert; blank creates incidents only.
alert_notification_email = ""

# WhatsApp Embedded Signup ("Connect with Facebook"), always on. Before the first apply, add the
# App Secret: gcloud secrets versions add meta-app-secret --data-file=… .
# Terraform stores the webhook verify token from private terraform.tfvars in Secret Manager.
meta_app_id                    = "1147422487864729"
meta_embedded_signup_config_id = "2124052078204370"
# Keep the exact Meta webhook verify token in the ignored terraform.tfvars only.
meta_webhook_verify_token      = ""
messaging_ingester_public_url  = ""

# Logging in with Google / Facebook comes with enable_firebase (identity.tf; enabling Identity Platform
# can't be undone). The providers are set up in the console (README).
