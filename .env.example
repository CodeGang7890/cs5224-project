# Copy to `.env` (next to `docker-compose.yml`). These are the values `docker-compose.yml`
# substitutes. Each service also has its own `.env.example` for running outside Docker.

# true: flush the database and reload every sample fixture on start. false (default): keep the data.
RESET_DB=false

# Meta's Graph API, used to connect WhatsApp and send replies. Unset: docker-compose's mock-whatsapp
# (its fake one). For the real Meta:
# META_GRAPH_API_URL=https://graph.facebook.com/v26.0

# Ollama runs on the host machine, not in Docker.
OLLAMA_HOST=http://host.docker.internal:11434

# notification-job's cron schedule (default: every hour, UTC).
NOTIFICATION_JOB_SCHEDULE=0 * * * *

# --- Xendit (payment-ingester) -------------------------------------------------------------
# The Xendit account's secret key (dashboard: Settings > API keys). Test mode for local development.
XENDIT_SECRET_KEY=

# The static token Xendit sends in the `x-callback-token` header (dashboard: Settings > Webhooks).
XENDIT_WEBHOOK_SECRET=dev-xendit-webhook-secret

XENDIT_API_BASE_URL=https://api.xendit.co
XENDIT_COUNTRY=SG
XENDIT_CURRENCY=SGD
# Comma-separated payment channels the customer may choose on Xendit's hosted page.
XENDIT_ALLOWED_PAYMENT_CHANNELS=CARDS
# How long the payment link stays open (seconds).
XENDIT_SESSION_EXPIRY_SECONDS=1800
# Xendit requires HTTPS return URLs; leave these empty for local development.
XENDIT_SUCCESS_URL=
XENDIT_FAILURE_URL=

# --- WhatsApp Embedded Signup ("Connect with Facebook") ---------------------------------------
# Our Meta app's ID, App Secret and Facebook Login for Business configuration ID, and the verify token
# of the app's own webhook (<messaging-ingester>/webhook). All empty (default): the button does nothing.
# Meta only runs the popup on HTTPS domains set on the app, so it can't be completed on localhost.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_APP_WEBHOOK_VERIFY_TOKEN=

# --- Logging in with Google / Facebook (Google Cloud Identity Platform) -------------------------
# The Firebase web app's apiKey and authDomain, and the project ID (`terraform output firebase_web_config`).
# configuration-service checks the logins against FIREBASE_PROJECT_ID. All empty (default): the buttons
# do nothing; username / password and sign up still work. localhost is an authorized domain.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
