# Copy to `.env` (next to `docker-compose.yml`). These are the values `docker-compose.yml`
# substitutes. Each service also has its own `.env.example` for running outside Docker.

# true: flush the database and reload every sample fixture on start. false (default): keep the data.
RESET_DB=false

# Meta's Graph API, used to check the WhatsApp details owners enter (override to point at a fake).
META_GRAPH_API_URL=https://graph.facebook.com/v25.0

# Ollama runs on the host machine, not in Docker.
OLLAMA_HOST=http://host.docker.internal:11434

# notification-job's cron schedule (default: every hour, UTC).
NOTIFICATION_JOB_SCHEDULE=0 * * * *

# --- Xendit (payment-ingester) -------------------------------------------------------------
# The Xendit account's secret key (dashboard: Settings > API keys). Test mode for local development.
XENDIT_SECRET_KEY=

# The static token Xendit sends in the `x-callback-token` header (dashboard: Settings > Webhooks).
XENDIT_WEBHOOK_SECRET=dev-xendit-webhook-secret

XENDIT_API_BASE_URL=https://api.xendit.co
XENDIT_COUNTRY=SG
XENDIT_CURRENCY=SGD
# Comma-separated payment channels the customer may choose on Xendit's hosted page.
XENDIT_ALLOWED_PAYMENT_CHANNELS=CARDS
# How long the payment link stays open (seconds).
XENDIT_SESSION_EXPIRY_SECONDS=1800
# Xendit requires HTTPS return URLs; leave these empty for local development.
XENDIT_SUCCESS_URL=
XENDIT_FAILURE_URL=
