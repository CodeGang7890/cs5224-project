# Environment variables read by config/settings.py.
# Export them in your shell (or via your process manager). Defaults shown are for local development.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Time zone of the services' weekly availability calendars (IANA name).
DJANGO_SCHEDULE_TIME_ZONE=Asia/Singapore
# Database: sqlite (default, db.sqlite3) or postgresql (configured below; docker-compose sets these).
DJANGO_DB_ENGINE=sqlite
POSTGRES_DB=configuration_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Ollama server for chat (from Docker: http://host.docker.internal:11434).
OLLAMA_HOST=http://localhost:11434
# WhatsApp connection. Encryption key for the stored secrets (any secret string; empty = SECRET_KEY).
CONFIGURATION_ENCRYPTION_KEY=
# Shared key for service-to-service calls to /api/internal/ (empty = internal API disabled; DEBUG default: dev-internal-api-key).
INTERNAL_API_KEY=dev-internal-api-key
# Signs the login (JWT) tokens; messaging-service checks them with the same key (empty = SECRET_KEY).
JWT_SIGNING_KEY=
# Public URL of messaging-ingester, shown to owners as their webhook Callback URL.
MESSAGING_INGESTER_PUBLIC_URL=http://localhost:8002
# Meta's Graph API, used to check the WhatsApp details owners enter.
META_GRAPH_API_URL=https://graph.facebook.com/v25.0
