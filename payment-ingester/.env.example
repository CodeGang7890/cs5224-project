# Environment variables for payment-ingester
# Export them in your shell (or via your process manager). Defaults shown are for local development.
# For `docker compose`, use the root `.env` / `.env.example` instead.

# --- Xendit Payment Sessions API (the hosted payment link the customer pays on) ------------
# The secret key of the Xendit account (test mode for now). Server-side only: never in the frontend.
XENDIT_SECRET_KEY=
XENDIT_API_BASE_URL=https://api.xendit.co
XENDIT_COUNTRY=SG
XENDIT_CURRENCY=SGD
# Comma-separated payment channels the customer may choose on Xendit's hosted page.
XENDIT_ALLOWED_PAYMENT_CHANNELS=CARDS
# How long the payment link stays open (seconds).
XENDIT_SESSION_EXPIRY_SECONDS=1800
# Xendit requires HTTPS return URLs; leave these empty for local development.
XENDIT_SUCCESS_URL=
XENDIT_FAILURE_URL=

# --- Xendit webhook receiver ----------------------------------------------------------------
# The token Xendit sends in the `x-callback-token` header (dashboard: Settings > Webhooks).
XENDIT_WEBHOOK_SECRET=change-me-to-a-secure-random-string

# The shared key other services send in the X-Internal-Api-Key header to create payments
# (messaging-service). Must equal configuration-service's INTERNAL_API_KEY.
INTERNAL_API_KEY=dev-internal-api-key

# --- Pub/Sub publisher (payment events to processing-service) ------------------------------
GCP_PROJECT_ID=local-project
PUBSUB_TOPIC=payment-events
PUBSUB_PUBLISH_TIMEOUT_SECONDS=5

# Local development: use the Pub/Sub emulator.
PUBSUB_EMULATOR_HOST=localhost:8085

# Server configuration
PORT=8001
WEB_CONCURRENCY=2
